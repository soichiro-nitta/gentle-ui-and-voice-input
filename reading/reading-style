#!/usr/bin/env python3
"""読み物の HTML を「やさしいUI」（reading.css）にそろえる・確かめる。

使い方:
  reading-style apply <file.html>...
      head の <style> を reading.css の中身に入れ替える（<style data-page> は残す）。
      viewport の meta を足し、本文を <main> で包み、表の古いクラス（<table class="lines">）を外して素の <table> にする。
      何度かけても同じ結果になる。
  reading-style check <file.html|フォルダ>... [--fix] [--json]
      共通の見た目を使っていないもの・書き方で直してほしいところを一覧で出す。
      フォルダを渡すと、その中の *.html をすべて見る。--fix は「そのまま直せるもの」だけ apply する。
      見つかったら終了コード 1、なければ 0。
  共通: --css <path> で reading.css の場所を変えられる（既定はこのスクリプトと同じフォルダの reading.css）。

決まり:
  - 共通の見た目を使っている印は、<style> の中の reading.css の1行目（MARK の文字）。
  - その読み物だけに要る分は <style data-page> に分けて書く。apply しても残る。
  - わざと違う見た目にするもの（アプリ風の試作など）は head に <meta name="reading-style" content="own"> を入れる。check から外れる。
  - 「そのまま直せるもの」：<script> がなく、本文のクラスがすべて reading.css（か data-page）にあるもの。
  - 要素に style= を直接書かない。大きさや余白は reading.css の形を使い、足りなければ reading.css へ足す。
  - 1段落1つのこと。「どこ：」「見方：」のようなラベル＋<br> で1段落に詰めない。
  - h1 のすぐ下に結論を1文（<p class="summary">）。結論を求めないページは <meta name="reading-lead" content="none">。
  - 画像は本文幅の2倍以上の幅（1280px 以上）の PNG にする（写真は品質の高い WebP・JPEG でもよい）。
    Retina の2倍（devicePixelRatio 2）で撮る。小さく切り抜いて拡大して載せない。部分が要るなら、その部分を2倍で撮り直す。
  - 本文は <main> で包む（見出し・段落の形は main h1・main p に当てているため）。
  - 表はクラスを付けない素の <table> で書く。見た目は reading.css が決める：線なし、データの行の1行おきに薄い面と角丸、
    見出しの行（th だけの行）は小さなグレーの文字、狭い画面では表の中だけ横に動く。数字の列は td.n（見出しは th.n）で右寄せ・等幅の数字。
    合否は色の文字だけ：<span class="ok">（緑＝合格）、<span class="ng">（赤＝不合格）、<span class="wait">（オレンジ＝注意）。枠・背景で囲まない。
    table.lines は古い書き方（apply が外す）。
  - 表は枠いっぱいで、列の幅は中身ではなく割合で固定する（table-layout: fixed）。同じ読み物の中で列の数が同じ表は、同じ割合にする。
    apply がそれぞれの列の長さ（数字・日付の列は短く、文章の列は長く）をまとめて測り、同じ割合の <colgroup data-cols><col style="width:N%">… を付ける
    （何度かけても同じ。手で書いた colgroup は残す）。<col> の style="width:N%" だけは書いてよい。
  - check の「直してほしい」：
      表に自前の style・線（data-page の border）・TABLE_CLASSES にないクラス（table.lines も。--fix は apply で外す）、
      列の数が同じなのに列の幅の割合がそろっていない表（--fix は apply）、
      本文の見出し・段落が <main> の外にある（--fix は <main> も <script> もないものだけ包む）、
      reading.css が古い（--fix で入れ直す）、reading.css のほかに <style>（data-page なし）や外の CSS（<link rel="stylesheet">）がある、
      reading.css にないクラスを使っている、本文の要素の style=、<br> の3つ以上の連続、「ラベル：」＋<br> が2か所以上、
      200字を超える段落（会話の生ログ p.raw は除く）、頭に結論がない、
      荒く見える画像（本文の <img> の幅が本文幅の2倍＝1280px に足りない。.pair の2枚並びは 640px。.scroll の中は見ない）。
    本文の文字がほとんどないページ（JavaScript で描く・絵だけ）と、frag*.html・*.before.html（作業のかけら・前の版）は見ない。
    own の印があるものは、書き方も見ない。
"""
import argparse
import json
import re
import sys
from pathlib import Path

DEFAULT_CSS = Path(__file__).resolve().parent / "reading.css"
MARK = "やさしいUI 読み物の共通の見た目"
OWN_RE = re.compile(r'<meta\s+name="reading-style"\s+content="own"', re.I)
NO_LEAD_RE = re.compile(r'<meta\s+name="reading-lead"\s+content="none"', re.I)
STYLE_RE = re.compile(r"<style\b([^>]*)>.*?</style>\s*", re.S | re.I)
SCRIPT_RE = re.compile(r"<(script|template)\b.*?</\1>", re.S | re.I)
TAG_RE = re.compile(r"<[^>]+>")
SVG_RE = re.compile(r"<svg\b.*?</svg>", re.S | re.I)
LONG = 200
OUTSIDE_MAIN = "本文が <main> の外にある（main h1・main p の見た目が当たらない）"
OLD_CSS = "reading.css が古い・書きかえてある（apply で入れ直す）"
LINK_CSS_RE = re.compile(r"<link\b[^>]*rel=[\"']?stylesheet[^>]*>", re.I)
# 作業の途中のかけら・前の版（読み物ではない）
SCRAP_RE = re.compile(r"(?:^|/)(?:frag[^/]*|[^/]*\.before)\.html$")
HEAD_SKIP = re.compile(r"\s*(?:<!--.*?-->|<h1\b.*?</h1>|<(p|div)\b[^>]*class=\"[^\"]*\b(?:meta|sub|muted)\b[^\"]*\"[^>]*>.*?</\1>)", re.S | re.I)

CSS_PATH = DEFAULT_CSS


def css():
    return CSS_PATH.read_text(encoding="utf-8")


def known_classes(text):
    return set(re.findall(r"\.([A-Za-z_][\w-]*)", text))


def has_main(src):
    return bool(re.search(r"<main\b", SCRIPT_RE.sub("", STYLE_RE.sub("", src)), re.I))


def wrap_main(src):
    """<main> がなければ、<body> の中身をそのまま <main> で包む。文章は変えない。"""
    if has_main(src):
        return src
    m = re.search(r"<body\b[^>]*>", src, re.I)
    if not m:
        return src
    end = re.search(r"</body>", src, re.I)
    stop = end.start() if end else len(src)
    return src[: m.end()] + "\n<main>\n" + src[m.end(): stop] + "\n</main>\n" + src[stop:]


def apply(src):
    keep = []

    def drop(m):
        if "data-page" in m.group(1):
            keep.append(m.group(0).strip())
        return ""

    src = STYLE_RE.sub(drop, src)
    block = "<style>\n" + css() + "</style>\n" + "".join(k + "\n" for k in keep)
    if not re.search(r'<meta\s+name="viewport"', src, re.I):
        block = '<meta name="viewport" content="width=device-width, initial-scale=1">\n' + block
    if re.search(r"</head>", src, re.I):
        src = re.sub(r"</head>", lambda _: block + "</head>", src, count=1, flags=re.I)
    elif re.search(r"<body\b", src, re.I):
        src = re.sub(r"<body\b", lambda _: block + "</head>\n<body", src, count=1, flags=re.I)
    else:
        src = block + src
    src = wrap_main(src)
    src = re.sub(r'<table class="lines">', "<table>", src)
    return add_colgroups(src)


# 表の列の幅：同じ読み物の中で列の数が同じ表は、同じ割合の <colgroup data-cols> にする
COLGROUP_AUTO_RE = re.compile(r"<colgroup\b[^>]*\bdata-cols\b[^>]*>.*?</colgroup>\s*", re.S | re.I)
COLGROUP_RE = re.compile(r"<colgroup\b.*?</colgroup>", re.S | re.I)
ROW_RE = re.compile(r"<tr\b[^>]*>(.*?)</tr>", re.S | re.I)
CELL_RE = re.compile(r"<(t[hd])\b([^>]*)>(.*?)</\1>", re.S | re.I)
SPAN_RE = re.compile(r"\bcolspan\s*=\s*\"?(\d+)", re.I)


def outside_script(src, fn):
    """<style>・<script>・<template> の外だけに fn をかける。"""
    parts = re.split(r"(<(?:script|template|style)\b.*?</(?:script|template|style)>)", src, flags=re.S | re.I)
    return "".join(p if i % 2 else fn(p) for i, p in enumerate(parts))


def text_width(html):
    """見た目の長さ（全角1、半角0.55）。"""
    t = re.sub(r"\s+", " ", TAG_RE.sub("", html)).strip()
    t = re.sub(r"&[a-z#0-9]+;", "x", t)
    return sum(1 if ord(ch) > 0x2000 else 0.55 for ch in t)


def table_rows(table):
    """[(cells, colspan のある行か)]。rowspan がある表は None（列がずれるので測らない）。"""
    if re.search(r"\browspan\s*=", table, re.I):
        return None
    return [CELL_RE.findall(r) for r in ROW_RE.findall(table)]


def col_count(rows):
    counts = [sum(int(m.group(1)) if (m := SPAN_RE.search(a)) else 1 for _, a, _ in cells) for cells in rows if cells]
    return max(counts) if counts else 0


def col_widths(tables):
    """同じ列の数の表をまとめて、列ごとの割合（%）を決める（表の幅は 960px として測る）。
    列が要る幅は、見出しの長さと、中身の長い方から2割あたりの長さの大きい方（1字16px、見出しは14px、左右の余白28px）。
    短い列（数字・日付・状態）は要る幅をそのまま取り、残りを文章の列で要る幅に応じて分ける。"""
    n = col_count(tables[0])
    head = [0.0] * n
    lens = [[] for _ in range(n)]
    for rows in tables:
        for cells in rows:
            if len(cells) != n:
                continue
            for i, (tag, _, body) in enumerate(cells):
                if tag.lower() == "th" and not any(t.lower() == "td" for t, _, _ in cells):
                    head[i] = max(head[i], text_width(body))
                else:
                    lens[i].append(text_width(body))
    need = []
    for i, xs in enumerate(lens):
        xs = sorted(xs) or [0]
        body = min(xs[min(len(xs) - 1, int(len(xs) * 0.8))], 40)
        need.append(max(body * 16, head[i] * 14, 36) + 28)
    total_w, short_max = 960, 200
    short = [i for i, w in enumerate(need) if w <= short_max]
    fixed = sum(need[i] for i in short)
    if fixed > total_w * 0.6 or len(short) == n:
        px = [w * total_w / sum(need) for w in need]
    else:
        rest = sum(need[i] for i in range(n) if i not in short)
        px = [need[i] if i in short else need[i] * (total_w - fixed) / rest for i in range(n)]
    pct = [max(6, round(w * 100 / total_w)) for w in px]
    pct[pct.index(max(pct))] += 100 - sum(pct)
    return pct


def add_colgroups(src):
    def fix(part):
        part = TABLE_RE.sub(lambda m: COLGROUP_AUTO_RE.sub("", m.group(0)), part)
        groups = {}
        for m in TABLE_RE.finditer(part):
            t = m.group(0)
            rows = table_rows(t)
            if COLGROUP_RE.search(t) or not rows:
                continue
            n = col_count(rows)
            if n >= 2:
                groups.setdefault(n, []).append(rows)
        widths = {n: col_widths(ts) for n, ts in groups.items()}

        def put(m):
            t = m.group(0)
            rows = table_rows(t)
            if COLGROUP_RE.search(t) or not rows or col_count(rows) not in widths:
                return t
            cols = "".join(f'<col style="width:{w}%">' for w in widths[col_count(rows)])
            return re.sub(r"(<table\b[^>]*>)", lambda h: h.group(1) + f"\n<colgroup data-cols>{cols}</colgroup>", t, count=1)

        return TABLE_RE.sub(put, part)

    return outside_script(src, fix)


def width_mismatch(src):
    """同じ読み物の中で、列の数が同じなのに列の幅の割合がそろっていない表があるか。"""
    seen = {}
    bad = set()
    for t in TABLE_RE.findall(SCRIPT_RE.sub("", STYLE_RE.sub("", src))):
        rows = table_rows(t)
        if not rows:
            continue
        n = col_count(rows)
        if n < 2:
            continue
        cg = COLGROUP_RE.search(t)
        key = tuple(re.findall(r"width\s*:\s*([\d.]+%?)", cg.group(0))) if cg else ("既定",)
        if seen.setdefault(n, key) != key:
            bad.add(n)
    return sorted(bad)


def outside_main(src):
    src = SCRIPT_RE.sub("", STYLE_RE.sub("", src))
    src = re.sub(r"<head\b.*?</head>", "", src, flags=re.S | re.I)
    src = re.sub(r"<main\b.*?</main>", "", src, flags=re.S | re.I)
    src = re.sub(r"<(nav|header|footer|svg|template)\b.*?</\1>", "", src, flags=re.S | re.I)
    return bool(re.search(r"<(h[1-3]|p)\b", src, re.I))


def body_classes(src):
    out = set()
    for attr in re.findall(r'\bclass="([^"]*)"', STYLE_RE.sub("", src)):
        out.update(attr.split())
    return out


def text_of(html):
    return re.sub(r"\s+", "", TAG_RE.sub("", html)).replace("&nbsp;", "")


def main_body(src):
    src = SCRIPT_RE.sub("", STYLE_RE.sub("", src))
    src = re.sub(r"<head\b.*?</head>", "", src, flags=re.S | re.I)
    m = re.search(r"<main\b[^>]*>(.*)</main>", src, re.S | re.I) or re.search(r"<body\b[^>]*>(.*)</body>", src, re.S | re.I)
    body = m.group(1) if m else re.sub(r"<!doctype[^>]*>|</?html\b[^>]*>|<meta\b[^>]*>|<link\b[^>]*>|<title\b.*?</title>", "", src, flags=re.S | re.I)
    return re.sub(r"<nav\b.*?</nav>", "", SVG_RE.sub("", body), flags=re.S | re.I)


def has_conclusion(body):
    if re.search(r'class="[^"]*\b(?:summary|lead)\b', body[:4000]):
        return True
    if re.search(r"<h[2-3]\b[^>]*>[^<]*(?:結論|まとめ|要点|いまの状態)", body[:1500]):
        return True
    rest = body
    while (m := HEAD_SKIP.match(rest)):
        rest = rest[m.end():]
    return bool(re.match(r"\s*<p\b", rest, re.I))


# 表の中で使ってよいクラス（reading.css の表の形）
TABLE_CLASSES = {"n", "ok", "ng", "wait", "warn", "err", "note", "sub", "meta", "small", "time", "key", "v", "cols-2", "cols-3", "cols-4", "cols-5"}
TABLE_RE = re.compile(r"<table\b.*?</table>", re.S | re.I)
BORDER_RE = re.compile(r"(?:^|[},\s])(?:table|tr|th|td|thead|tbody)\b[^{}]*\{[^}]*\bborder(?:-(?:top|bottom|left|right))?\s*:", re.I)


def table_issues(src):
    """表の書き方：自前の style・線・知らないクラス。表は素の <table> にして、見た目は reading.css に任せる。"""
    tables = TABLE_RE.findall(SCRIPT_RE.sub("", STYLE_RE.sub("", src)))
    page_css = "".join(m.group(0) for m in STYLE_RE.finditer(src) if "data-page" in m.group(1))
    out = []
    if any(re.search(r"\sstyle\s*=", re.sub(r'<col\b[^>]*\bstyle="\s*width\s*:\s*[\d.]+%;?\s*"[^>]*>', "", t, flags=re.I), re.I) for t in tables):
        out.append("表に自前の style=")
    if BORDER_RE.search(page_css):
        out.append("表に自前の線（data-page の border）")
    bad = set()
    for t in tables:
        for attr in re.findall(r'\bclass="([^"]*)"', t):
            bad.update(c for c in attr.split() if c not in TABLE_CLASSES)
    if bad:
        out.append("表に知らないクラス（" + " ".join(sorted(bad)) + "。素の table と n・ok・ng・wait で）")
    mismatch = width_mismatch(src)
    if mismatch:
        out.append("表の列の幅がそろっていない（" + "・".join(f"{n}列" for n in mismatch) + "の表。apply で同じ割合に）")
    return out


IMG_MIN = 1280
IMG_RE = re.compile(r"<img\b[^>]*\bsrc=\"([^\"]+)\"", re.I)
PAIR_RE = re.compile(r"<(div|figure)\b[^>]*class=\"[^\"]*\bpair\b[^\"]*\"[^>]*>.*?</\1>", re.S | re.I)
# .scroll の中は元の大きさのまま出す（本文幅に広げない）ので、幅では見ない
SCROLL_RE = re.compile(r"<(div|figure)\b[^>]*class=\"[^\"]*\bscroll\b[^\"]*\"[^>]*>.*?</\1>", re.S | re.I)


def image_width(path):
    """PNG・JPEG・WebP・GIF の幅（px）。読めなければ None。"""
    try:
        with open(path, "rb") as f:
            head = f.read(64 * 1024)
    except OSError:
        return None
    if head[:8] == b"\x89PNG\r\n\x1a\n":
        return int.from_bytes(head[16:20], "big")
    if head[:6] in (b"GIF87a", b"GIF89a"):
        return int.from_bytes(head[6:8], "little")
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        kind = head[12:16]
        if kind == b"VP8X":
            return int.from_bytes(head[24:27], "little") + 1
        if kind == b"VP8 ":
            return int.from_bytes(head[26:28], "little") & 0x3FFF
        if kind == b"VP8L":
            return (int.from_bytes(head[21:25], "little") & 0x3FFF) + 1
        return None
    if head[:2] == b"\xff\xd8":
        i = 2
        while i + 9 < len(head):
            if head[i] != 0xFF:
                i += 1
                continue
            marker = head[i + 1]
            if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                return int.from_bytes(head[i + 7:i + 9], "big")
            i += 2 + int.from_bytes(head[i + 2:i + 4], "big")
    return None


def blurry_images(body, path):
    """本文幅の2倍に足りない画像（荒く見える）。ファイルが手元にないもの・SVG・data: は見ない。"""
    if not path:
        return []
    base = Path(path).parent
    in_pair = {m for blk in PAIR_RE.finditer(body) for m in IMG_RE.findall(blk.group(0))}
    body = SCROLL_RE.sub("", body)
    out = []
    for src in dict.fromkeys(IMG_RE.findall(body)):
        if re.match(r"(?:[a-z]+:|//)", src, re.I) and not src.startswith("file://"):
            continue
        local = base / re.sub(r"^file://", "", src).split("?")[0].split("#")[0]
        if src.startswith("file://"):
            local = Path(re.sub(r"^file://", "", src))
        if local.suffix.lower() == ".svg":
            continue
        width = image_width(local)
        need = IMG_MIN // 2 if src in in_pair else IMG_MIN
        if width and width < need:
            out.append(f"{Path(src).name} {width}px")
    return out


def lint(src, path=""):
    """書き方の「直してほしい」。本文の文字がほとんどないページ（JavaScript で描く・絵だけ）は見ない。"""
    body = main_body(src)
    if len(text_of(body)) < 40:
        return []
    out = table_issues(src)
    blurry = blurry_images(body, path)
    if blurry:
        out.append(f"画像が荒い（幅が本文幅の2倍の{IMG_MIN}px に足りない：" + "、".join(blurry[:4]) + (f" ほか{len(blurry) - 4}枚" if len(blurry) > 4 else "") + "。2倍で撮り直す）")
    styled = sorted({t.lower() for t in re.findall(r"<([a-zA-Z][\w-]*)\b[^>]*\sstyle\s*=", body)} - {"col"})
    if styled:
        out.append("要素に直接 style=（" + " ".join(styled) + "）")
    if re.search(r"(?:<br\s*/?>\s*){3,}", body, re.I):
        out.append("<br> を3つ以上つなげている")
    labels = re.findall(r"<(?:b|strong)\b[^>]*>[^<]{1,20}(?:[：:]\s*</(?:b|strong)>|</(?:b|strong)>\s*[：:])[^<]*?<br\s*/?>", body, re.I)
    if len(labels) >= 2:
        out.append(f"「ラベル：」＋改行で詰めている（{len(labels)}か所）")
    paras = re.findall(r"<p\b([^>]*)>(.*?)</p>", body, re.S | re.I)
    long = [n for n in (len(text_of(x)) for a, x in paras if "raw" not in a) if n > LONG]
    if long:
        out.append(f"{LONG}字を超える段落が{len(long)}つ（最長{max(long)}字）")
    if not NO_LEAD_RE.search(src) and not has_conclusion(body):
        out.append("頭に結論の段落がない（h1 のすぐ下に p.summary を）")
    return out


def style_warn(src):
    """共通の見た目を入れたつもりでも効かない原因：古い reading.css、ほかの CSS、reading.css にないクラス。"""
    out = []
    blocks = [(m.group(1), m.group(0)) for m in STYLE_RE.finditer(src)]
    mine = [b for a, b in blocks if MARK in b]
    if mine and css().strip() not in mine[0]:
        out.append(OLD_CSS)
    others = [b for a, b in blocks if MARK not in b and "data-page" not in a]
    if others:
        out.append(f"reading.css のほかに <style> が{len(others)}つ（その読み物だけの分なら data-page を付ける）")
    if LINK_CSS_RE.search(src):
        out.append("外の CSS を読み込んでいる（<link rel=\"stylesheet\">。reading.css の形を上書きすることがある）")
    extra = "".join(b for a, b in blocks if "data-page" in a)
    unknown = sorted(body_classes(src) - known_classes(css() + extra) - {"lines"})
    if unknown:
        out.append("reading.css にないクラス：" + " ".join(unknown))
    return out


def inspect(path):
    src = path.read_text(encoding="utf-8", errors="replace")
    if OWN_RE.search(src):
        return None
    warn = lint(src, str(path))
    if MARK in src:
        warn = style_warn(src) + warn
        if outside_main(src):
            warn.insert(0, OUTSIDE_MAIN)
        return {"path": str(path), "ok_style": True, "warn": warn} if warn else None
    extra = "".join(m.group(0) for m in STYLE_RE.finditer(src) if "data-page" in m.group(1))
    unknown = sorted(body_classes(src) - known_classes(css() + extra) - {"lines"})
    has_script = bool(re.search(r"<script\b", src, re.I))
    return {"path": str(path), "auto": not unknown and not has_script, "unknown": unknown, "script": has_script, "warn": warn}


def candidates(targets):
    for t in targets:
        p = Path(t)
        if p.is_dir():
            yield from (f for f in sorted(p.rglob("*.html")) if not SCRAP_RE.search(str(f)))
        elif p.suffix.lower() == ".html":
            yield p


def main():
    global CSS_PATH
    ap = argparse.ArgumentParser(description="読み物の HTML をやさしいUI（reading.css）にそろえる・確かめる")
    ap.add_argument("--css", help="reading.css の場所（既定はスクリプトと同じフォルダ）")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("apply")
    a.add_argument("files", nargs="+")
    c = sub.add_parser("check")
    c.add_argument("targets", nargs="+")
    c.add_argument("--fix", action="store_true")
    c.add_argument("--json", action="store_true")
    args = ap.parse_args()
    if args.css:
        CSS_PATH = Path(args.css)

    if args.cmd == "apply":
        for f in args.files:
            p = Path(f)
            p.write_text(apply(p.read_text(encoding="utf-8")), encoding="utf-8")
            print(f"そろえた：{p}")
        return 0

    found = [r for r in (inspect(f) for f in candidates(args.targets)) if r]
    for r in found:
        if args.fix and r.get("auto"):
            p = Path(r["path"])
            p.write_text(apply(p.read_text(encoding="utf-8")), encoding="utf-8")
            r["fixed"] = True
        elif args.fix and r.get("ok_style") and (OLD_CSS in r["warn"] or any("lines" in w or w.startswith("表の列の幅") for w in r["warn"])):
            p = Path(r["path"])
            p.write_text(apply(p.read_text(encoding="utf-8")), encoding="utf-8")
            r["warn"] = [w for w in (inspect(p) or {}).get("warn", [])]
            r["fixed"] = not r["warn"]
        elif args.fix and r.get("ok_style") and OUTSIDE_MAIN in r["warn"]:
            p = Path(r["path"])
            src = p.read_text(encoding="utf-8")
            if not has_main(src) and not re.search(r"<script\b", src, re.I):
                p.write_text(wrap_main(src), encoding="utf-8")
                r["warn"].remove(OUTSIDE_MAIN)
                r["fixed"] = not r["warn"]
    if args.json:
        print(json.dumps(found, ensure_ascii=False, indent=1))
    else:
        for r in found:
            if r.get("ok_style"):
                if r.get("fixed"):
                    print(f"直した　　{r['path']}")
                elif r["warn"]:
                    print(f"直してほしい　{r['path']}（{'、'.join(r['warn'])}）")
            elif r.get("fixed"):
                print(f"直した　　{r['path']}")
            elif r.get("auto"):
                print(f"直せる　　{r['path']}")
            else:
                why = ("script あり、" if r["script"] else "") + ("知らないクラス：" + " ".join(r["unknown"]) if r["unknown"] else "")
                print(f"手で直す　{r['path']}（{why.rstrip('、')}）")
            if r.get("warn") and not r.get("ok_style"):
                print(f"　　書き方：{'、'.join(r['warn'])}")
        if not found:
            print("問題なし")
    return 1 if [r for r in found if not r.get("fixed")] else 0


if __name__ == "__main__":
    sys.exit(main())
