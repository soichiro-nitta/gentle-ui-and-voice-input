{
  "title": "Koe Mac（右シフトで話す）",
  "rules": [
    {
      "description": "右シフトを単独で短く押す → F17（話し続けモードの切り替え）、単独で長押し → F18（録音の開始）、離したら F19（終わり）。ほかのキーと一緒なら右シフトのまま",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "right_shift", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_shift" }],
          "to_if_alone": [{ "key_code": "f17" }],
          "to_if_held_down": [{ "key_code": "f18", "repeat": false }],
          "to_after_key_up": [{ "key_code": "f19" }],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 300,
            "basic.to_if_held_down_threshold_milliseconds": 300
          }
        }
      ]
    }
  ]
}
